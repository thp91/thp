# Copier ce fichier en .env.local (jamais commité) et renseigner la clé Resend.
# En production (Vercel) : Project Settings → Environment Variables.
RESEND_API_KEY=
CONTACT_TO=thp.development.pro@gmail.com
# Après vérification de votre domaine dans Resend, par exemple :
# CONTACT_FROM=THP Development <contact@votre-domaine.fr>

# --- Espace admin (/admin) ----------------------------------------------
ADMIN_PASSWORD=
# Chaîne aléatoire longue (signature des sessions et de l'analytics)
ADMIN_SESSION_SECRET=

# --- Analytics : Upstash for Redis (fourni par l'intégration Vercel) ----
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Prospection (local uniquement) -------------------------------------
# Adresse d'expédition sur un domaine vérifié dans Resend
PROSPECT_FROM=
SENDER_PHONE=
